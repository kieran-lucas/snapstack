<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SnapStack.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid>
            <Ellipse
                Width="520"
                Height="520"
                Margin="-210,-250,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{StaticResource AppAccentTranslucentBrush}"
                Opacity="0.34" />
            <Ellipse
                Width="460"
                Height="460"
                Margin="0,180,-230,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Fill="{StaticResource AppCyanTranslucentBrush}"
                Opacity="0.28" />
            <Ellipse
                Width="340"
                Height="340"
                Margin="0,0,80,-220"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="{StaticResource AppPinkTranslucentBrush}"
                Opacity="0.22" />
        </Grid>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                MaxWidth="1160"
                Margin="36,28,36,44"
                HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="13">
                        <Border
                            Width="44"
                            Height="44"
                            Background="{StaticResource AppAccentGradientBrush}"
                            CornerRadius="14">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="21"
                                Foreground="White"
                                Glyph="&#xE8B9;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                Style="{StaticResource HeadingTextStyle}"
                                Text="SnapStack" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="CAPTURE SESSION / WINDOWS" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="11,6"
                        VerticalAlignment="Center"
                        Background="{StaticResource AppSurfaceRaisedBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="999">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="{StaticResource AppSuccessBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Foreground="{StaticResource AppTextSecondaryBrush}"
                                Text="MVP 0.1" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Hero -->
                <Border
                    Grid.Row="2"
                    Padding="30"
                    Background="{StaticResource AppHeroGradientBrush}"
                    BorderBrush="#357E73FF"
                    BorderThickness="1"
                    CornerRadius="26">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            MaxWidth="650"
                            VerticalAlignment="Center"
                            Spacing="16">
                            <Border
                                Padding="10,5"
                                HorizontalAlignment="Left"
                                Background="{StaticResource AppAccentTranslucentBrush}"
                                CornerRadius="999">
                                <TextBlock
                                    FontFamily="{StaticResource AppFontFamily}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AppAccentBrightBrush}"
                                    Text="CAPTURE FAST. PASTE ONCE." />
                            </Border>

                            <TextBlock
                                Style="{StaticResource DisplayTextStyle}"
                                Text="Your screenshots,&#x0a;stacked in one flow." />

                            <TextBlock
                                MaxWidth="570"
                                Style="{StaticResource BodyTextStyle}"
                                FontSize="15"
                                LineHeight="23"
                                Text="Start a session, grab every region you need, then paste the ordered stack in one action. No repetitive save, rename, or clipboard juggling." />

                            <StackPanel
                                Margin="0,5,0,0"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button
                                    x:Name="StartButton"
                                    Click="StartButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="16"
                                            Glyph="&#xE768;" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="Start session" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="CaptureButton"
                                    Click="CaptureButton_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="16"
                                            Glyph="&#xE722;" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="Capture" />
                                    </StackPanel>
                                </Button>

                                <ProgressRing
                                    x:Name="ActivityRing"
                                    Width="22"
                                    Height="22"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource AppCyanBrush}"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Original anime-tech hologram -->
                        <Grid
                            Grid.Column="1"
                            Width="310"
                            Height="236"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Ellipse
                                Width="224"
                                Height="224"
                                Fill="{StaticResource AppAnimeGlowBrush}"
                                Opacity="0.45" />

                            <Ellipse
                                Width="196"
                                Height="196"
                                Fill="#B30C1220"
                                Stroke="#568B6CFF"
                                StrokeThickness="1" />

                            <Ellipse
                                Width="164"
                                Height="164"
                                Fill="#68121A2B"
                                Stroke="#3854D7FF"
                                StrokeThickness="1" />

                            <!-- hair silhouette -->
                            <Path
                                Width="150"
                                Height="172"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M24,118 C12,71 28,30 66,16 C99,3 137,24 143,63 C149,101 134,136 115,153 C128,128 129,92 113,65 C94,32 55,39 42,64 C30,86 33,108 42,132 C34,128 28,123 24,118 Z"
                                Fill="#A13A2F6A"
                                Stretch="Fill" />

                            <!-- face -->
                            <Path
                                Width="92"
                                Height="124"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M45,4 C70,4 88,25 87,55 C86,86 67,116 46,120 C27,117 8,87 7,56 C6,26 22,5 45,4 Z"
                                Fill="#E0192235"
                                Stroke="#507E73FF"
                                StrokeThickness="1"
                                Stretch="Fill" />

                            <!-- cyber fringe -->
                            <Path
                                Width="102"
                                Height="70"
                                Margin="0,-66,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M4,54 C14,19 43,2 73,11 C91,16 99,29 99,47 C80,31 64,31 48,42 C36,50 24,57 4,54 Z"
                                Fill="#D44A397E"
                                Stretch="Fill" />

                            <!-- luminous eyes -->
                            <StackPanel
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="21">
                                <Border
                                    Width="24"
                                    Height="4"
                                    Background="{StaticResource AppCyanBrush}"
                                    CornerRadius="4" />
                                <Border
                                    Width="24"
                                    Height="4"
                                    Background="{StaticResource AppPinkBrush}"
                                    CornerRadius="4" />
                            </StackPanel>

                            <!-- visor -->
                            <Border
                                Width="112"
                                Height="28"
                                Margin="0,-4,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#5554D7FF"
                                BorderThickness="1"
                                CornerRadius="14" />

                            <!-- shoulders -->
                            <Path
                                Width="176"
                                Height="62"
                                Margin="0,143,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M5,58 C17,24 45,9 87,9 C130,9 158,24 171,58 Z"
                                Fill="#E0162035"
                                Stroke="#408B6CFF"
                                StrokeThickness="1"
                                Stretch="Fill" />

                            <Border
                                Width="62"
                                Height="24"
                                Margin="0,0,-208,-155"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#D0121A2C"
                                BorderBrush="#4054D7FF"
                                BorderThickness="1"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource AppFontFamily}"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AppCyanBrush}"
                                    Text="SYNC 01" />
                            </Border>

                            <TextBlock
                                Margin="-230,0,0,-188"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppFontFamily}"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AppTextMutedBrush}"
                                Text="NEON CAPTURE" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Metrics -->
                <Grid Grid.Row="4" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SoftCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="SESSION STATUS" />
                                <TextBlock
                                    x:Name="StatusText"
                                    Style="{StaticResource HeadingTextStyle}"
                                    Text="Idle" />
                            </StackPanel>
                            <Border
                                x:Name="StatusIconBorder"
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Background="{StaticResource AppAccentTranslucentBrush}"
                                CornerRadius="12">
                                <Grid>
                                    <FontIcon
                                        x:Name="StatusIcon"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="18"
                                        Foreground="{StaticResource AppAccentBrightBrush}"
                                        Glyph="&#xE9D9;"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <Ellipse
                                        x:Name="StatusDot"
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,5,5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Fill="{StaticResource AppTextMutedBrush}"
                                        Stroke="{StaticResource AppSurfaceRaisedBrush}"
                                        StrokeThickness="2" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource SoftCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="CAPTURED" />
                                <TextBlock
                                    x:Name="CountText"
                                    Style="{StaticResource MetricTextStyle}"
                                    Text="0" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Background="{StaticResource AppCyanTranslucentBrush}"
                                CornerRadius="12">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="18"
                                    Foreground="{StaticResource AppCyanBrush}"
                                    Glyph="&#xE91B;"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Style="{StaticResource SoftCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="CAPTURE" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border
                                        Padding="7,4"
                                        Background="#1EFFFFFF"
                                        CornerRadius="7">
                                        <TextBlock
                                            FontFamily="{StaticResource AppFontFamily}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="CTRL + SHIFT + S" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="6">
                                <TextBlock
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="FALLBACK PASTE" />
                                <Border
                                    Padding="7,4"
                                    HorizontalAlignment="Left"
                                    Background="#1EFFFFFF"
                                    CornerRadius="7">
                                    <TextBlock
                                        FontFamily="{StaticResource AppFontFamily}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Text="CTRL + SHIFT + V" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Controls -->
                <Border
                    Grid.Row="6"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                Style="{StaticResource SubheadingTextStyle}"
                                Text="Session controls" />
                            <TextBlock
                                Style="{StaticResource BodyTextStyle}"
                                Text="Native Ctrl+V is preferred. Use compatibility paste only for apps that cannot consume the full stack." />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button
                                x:Name="StopButton"
                                Click="StopButton_Click"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="15"
                                        Glyph="&#xE71A;" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Stop" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="ClearButton"
                                Click="ClearButton_Click"
                                IsEnabled="False"
                                Style="{StaticResource DangerButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="15"
                                        Glyph="&#xE74D;" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Clear" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Feedback -->
                <Border
                    Grid.Row="8"
                    Padding="16,13"
                    Background="#B50D1321"
                    BorderBrush="{StaticResource AppHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid ColumnSpacing="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="FeedbackBadge"
                            Width="30"
                            Height="30"
                            Background="{StaticResource AppAccentTranslucentBrush}"
                            CornerRadius="9">
                            <FontIcon
                                x:Name="FeedbackIcon"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Foreground="{StaticResource AppAccentBrightBrush}"
                                Glyph="&#xE946;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            x:Name="FeedbackText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextStyle}"
                            Text="Start a session, capture rectangles, then paste the full stack with Ctrl+V."
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
