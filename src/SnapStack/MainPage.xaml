<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SnapStack.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Invoked="StartKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- Soft ink-wash atmosphere, drawn with native shapes. -->
        <Ellipse
            Width="520"
            Height="520"
            Margin="-250,-300,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Fill="{StaticResource AppAccentTranslucentBrush}"
            Opacity="0.44" />
        <Ellipse
            Width="440"
            Height="440"
            Margin="0,0,-250,-250"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Fill="{StaticResource AppCyanTranslucentBrush}"
            Opacity="0.3" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid
                MaxWidth="740"
                Margin="20,18,20,26"
                HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Width="46"
                            Height="46"
                            Padding="5"
                            Background="#EAF4FFFF"
                            CornerRadius="14">
                            <Image Source="ms-appx:///Assets/SnapStackLogo.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Style="{StaticResource HeadingTextStyle}" Text="SnapStack" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="SCREENSHOT FLOW" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="11,6"
                        VerticalAlignment="Center"
                        Background="{StaticResource AppSurfaceRaisedBrush}"
                        BorderBrush="{StaticResource AppHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="99">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AppSuccessBrush}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Foreground="{StaticResource AppTextSecondaryBrush}"
                                Text="READY" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Main illustrated card -->
                <Border
                    Grid.Row="2"
                    MinHeight="270"
                    Padding="24,22"
                    Background="{StaticResource AppHeroGradientBrush}"
                    BorderBrush="#4A67B7FF"
                    BorderThickness="1"
                    CornerRadius="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.18*" />
                            <ColumnDefinition Width="0.82*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel MaxWidth="470" VerticalAlignment="Center" Spacing="13">
                            <Border
                                Padding="10,5"
                                HorizontalAlignment="Left"
                                Background="{StaticResource AppCyanTranslucentBrush}"
                                BorderBrush="#3A7BE3F8"
                                BorderThickness="1"
                                CornerRadius="99">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AppCyanBrush}"
                                    Text="CAPTURE • STACK • FLOW" />
                            </Border>

                            <TextBlock
                                Style="{StaticResource DisplayTextStyle}"
                                Text="One flow.&#x0a;Every screenshot." />

                            <TextBlock
                                MaxWidth="450"
                                Style="{StaticResource BodyTextStyle}"
                                FontSize="14"
                                LineHeight="22"
                                Text="Collect each frame in order, finish the session, then press Ctrl+V once. SnapStack handles the rest." />

                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="9">
                                <Button x:Name="StartButton" Click="StartButton_Click" Style="{StaticResource PrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE768;" />
                                        <TextBlock FontWeight="SemiBold" Text="Start session" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="CaptureButton" Click="CaptureButton_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE722;" />
                                        <TextBlock FontWeight="SemiBold" Text="Capture" />
                                    </StackPanel>
                                </Button>

                                <ProgressRing
                                    x:Name="ActivityRing"
                                    Width="21"
                                    Height="21"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource AppCyanBrush}"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Anime-inspired speed lines and stacked frames; no character art. -->
                        <Grid Grid.Column="1" Width="190" Height="184" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="176" Height="176" Fill="{StaticResource AppAnimeGlowBrush}" Opacity="0.34" />

                            <Border
                                Width="132"
                                Height="94"
                                Margin="-28,-28,0,0"
                                Background="#66112642"
                                BorderBrush="#487BE3F8"
                                BorderThickness="2"
                                CornerRadius="18"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="-8" /></Border.RenderTransform>
                            </Border>
                            <Border
                                Width="132"
                                Height="94"
                                Margin="10,0,0,0"
                                Background="#B2122C4B"
                                BorderBrush="#8067B7FF"
                                BorderThickness="2"
                                CornerRadius="18"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="-2" /></Border.RenderTransform>
                            </Border>
                            <Border
                                Width="132"
                                Height="94"
                                Margin="38,28,0,0"
                                Background="#E0102744"
                                BorderBrush="{StaticResource AppCyanBrush}"
                                BorderThickness="2"
                                CornerRadius="18">
                                <Grid>
                                    <Image
                                        Width="62"
                                        Height="62"
                                        Opacity="0.94"
                                        Source="ms-appx:///Assets/SnapStackLogo.png"
                                        Stretch="Uniform" />
                                    <Border
                                        Width="42"
                                        Height="4"
                                        Margin="0,0,14,12"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource AppAccentGradientBrush}"
                                        CornerRadius="4" />
                                </Grid>
                            </Border>

                            <Path
                                Width="182"
                                Height="70"
                                Margin="0,94,0,0"
                                Data="M3,49 C49,8 92,85 142,42 C177,12 213,20 242,3 C213,46 182,54 148,63 C93,78 55,42 3,82"
                                Stroke="{StaticResource AppCyanBrush}"
                                StrokeThickness="3"
                                StrokeLineJoin="Round"
                                Stretch="Fill"
                                Opacity="0.72" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Shortcut strip -->
                <Grid Grid.Row="4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SoftCardStyle}">
                        <StackPanel Spacing="7">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="START" />
                            <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="S" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                        <StackPanel Spacing="7">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="CAPTURE" />
                            <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="CTRL + Z" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SoftCardStyle}">
                        <StackPanel Spacing="7">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="END SESSION" />
                            <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="CTRL + X" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource SoftCardStyle}">
                        <StackPanel Spacing="7">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="PASTE STACK" />
                            <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="CTRL + V" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Session card -->
                <Border Grid.Row="6" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.55*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="5">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="SESSION STATUS" />
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Ellipse
                                    x:Name="StatusDot"
                                    Width="9"
                                    Height="9"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource AppTextMutedBrush}" />
                                <FontIcon
                                    x:Name="StatusIcon"
                                    Width="0"
                                    Height="0"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="1"
                                    Glyph="&#xE9D9;"
                                    Opacity="0" />
                                <TextBlock x:Name="StatusText" Style="{StaticResource HeadingTextStyle}" Text="Idle" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="CAPTURED" />
                            <TextBlock x:Name="CountText" Style="{StaticResource MetricTextStyle}" Text="0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StopButton" Click="StopButton_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE71A;" />
                                    <TextBlock Text="End" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearButton" Click="ClearButton_Click" IsEnabled="False" Style="{StaticResource DangerButtonStyle}">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Live feedback -->
                <Border
                    Grid.Row="8"
                    Padding="14,12"
                    Background="#B80A1829"
                    BorderBrush="{StaticResource AppHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="13">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="FeedbackIcon"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Foreground="{StaticResource AppAccentBrightBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock
                            x:Name="FeedbackText"
                            Grid.Column="1"
                            Style="{StaticResource BodyTextStyle}"
                            Text="Press S to start a session."
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
