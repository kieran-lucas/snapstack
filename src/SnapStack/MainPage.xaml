<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SnapStack.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="32"
                FontWeight="SemiBold"
                Text="SnapStack" />
            <TextBlock
                MaxWidth="520"
                HorizontalAlignment="Center"
                Text="Capture multiple screenshots into one session, then paste the entire stack in one action."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Opacity="0.65"
                Text="Capture engine: not initialized" />
        </StackPanel>
    </Grid>
</Page>
