<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SnapStack.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">
        <StackPanel
            MaxWidth="640"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">

            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="SnapStack" />
                <TextBlock
                    Opacity="0.7"
                    Text="Capture multiple screenshots into one session, then paste the entire stack in one action."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="20"
                CornerRadius="12">
                <Grid ColumnSpacing="24" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        FontWeight="SemiBold"
                        Text="Status" />
                    <TextBlock
                        x:Name="StatusText"
                        Grid.Row="0"
                        Grid.Column="1" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        FontWeight="SemiBold"
                        Text="Captured" />
                    <TextBlock
                        x:Name="CountText"
                        Grid.Row="1"
                        Grid.Column="1" />
                </Grid>
            </Border>

            <StackPanel
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    x:Name="StartButton"
                    Click="StartButton_Click"
                    Content="Start session" />
                <Button
                    x:Name="CaptureButton"
                    Click="CaptureButton_Click"
                    Content="Capture"
                    IsEnabled="False" />
                <Button
                    x:Name="StopButton"
                    Click="StopButton_Click"
                    Content="Stop"
                    IsEnabled="False" />
                <Button
                    x:Name="ClearButton"
                    Click="ClearButton_Click"
                    Content="Clear"
                    IsEnabled="False" />
            </StackPanel>

            <TextBlock
                x:Name="FeedbackText"
                Opacity="0.6"
                Text="Start a session, then capture a window or display."
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
