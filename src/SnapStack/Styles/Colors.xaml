<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AppBackgroundColor">#07111F</Color>
    <Color x:Key="AppSurfaceColor">#0B1A2C</Color>
    <Color x:Key="AppSurfaceRaisedColor">#10243A</Color>
    <Color x:Key="AppSurfaceSoftColor">#142D48</Color>
    <Color x:Key="AppBorderColor">#274968</Color>

    <Color x:Key="AppTextPrimaryColor">#F4F8FF</Color>
    <Color x:Key="AppTextSecondaryColor">#B5C8DD</Color>
    <Color x:Key="AppTextMutedColor">#7592AF</Color>

    <Color x:Key="AppAccentColor">#3478F6</Color>
    <Color x:Key="AppAccentBrightColor">#67B7FF</Color>
    <Color x:Key="AppCyanColor">#7BE3F8</Color>
    <Color x:Key="AppPinkColor">#79BFFF</Color>
    <Color x:Key="AppSuccessColor">#67DFC4</Color>
    <Color x:Key="AppWarningColor">#FFD17A</Color>
    <Color x:Key="AppDangerColor">#FF8DA1</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="{StaticResource AppSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="AppSurfaceSoftBrush" Color="{StaticResource AppSurfaceSoftColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />

    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource AppTextMutedColor}" />

    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentBrightBrush" Color="{StaticResource AppAccentBrightColor}" />
    <SolidColorBrush x:Key="AppCyanBrush" Color="{StaticResource AppCyanColor}" />
    <SolidColorBrush x:Key="AppPinkBrush" Color="{StaticResource AppPinkColor}" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />

    <SolidColorBrush x:Key="AppAccentTranslucentBrush" Color="#323478F6" />
    <SolidColorBrush x:Key="AppCyanTranslucentBrush" Color="#247BE3F8" />
    <SolidColorBrush x:Key="AppPinkTranslucentBrush" Color="#1879BFFF" />
    <SolidColorBrush x:Key="AppHairlineBrush" Color="#24BCE8FF" />

    <LinearGradientBrush x:Key="AppHeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#142D52" />
        <GradientStop Offset="0.52" Color="#0D2039" />
        <GradientStop Offset="1" Color="#0A1728" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#74E5FF" />
        <GradientStop Offset="0.48" Color="#438DF8" />
        <GradientStop Offset="1" Color="#2455D8" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppAnimeGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#407BE3F8" />
        <GradientStop Offset="0.55" Color="#353478F6" />
        <GradientStop Offset="1" Color="#101B4E8A" />
    </LinearGradientBrush>
</ResourceDictionary>
